# Required on Vercel; change if the password is ever shared unintentionally.
WEDDING_PASSWORD=STWed2027
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEDDING_SESSION_SECRET=REPLACE_WITH_A_RANDOM_64_CHAR_SECRET

# When configured, all shared planning data and uploaded images go to your Google Drive folder.
# You get both values by following README.md and google-apps-script/SETUP.md
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# Optional for local server
PORT=3000
